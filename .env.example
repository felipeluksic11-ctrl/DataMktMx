# =============================================================================
# Propyte Data Mining — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env
# =============================================================================

# PostgreSQL
POSTGRES_USER=propyte
POSTGRES_PASSWORD=changeme
POSTGRES_DB=propyte_data
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeme

# S3 (export)
S3_BUCKET=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Proxies
PROXY_DATAIMPLULSE_URL=
PROXY_BRIGHTDATA_URL=

# Anthropic (AI supervisors)
ANTHROPIC_API_KEY=

# App
ENVIRONMENT=development
LOG_LEVEL=INFO
