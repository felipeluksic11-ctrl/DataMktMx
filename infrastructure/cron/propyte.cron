# Propyte Data Mining — Cron Schedule
# Install: crontab /opt/propyte/infrastructure/cron/propyte.cron
#
# Strategy: daily incremental + monthly full
# Incremental: sort by recent, stop on known (~0.86GB/day, ~30min)
# Full: all pages, detect removed listings (~1.2GB cards, ~12hrs)

# Daily incremental scrape (2am Mexico = 8am UTC)
0 8 * * * cd /opt/propyte && docker compose -f docker-compose.prod.yml exec -T scraper-core python -m orchestrator.scheduler incremental >> /var/log/propyte/scheduler.log 2>&1

# Monthly full scrape (1st of month, midnight Mexico = 6am UTC)
0 6 1 * * cd /opt/propyte && docker compose -f docker-compose.prod.yml exec -T scraper-core python -m orchestrator.scheduler full >> /var/log/propyte/scheduler.log 2>&1

# Database backup to S3 (Sunday 4am UTC)
0 4 * * 0 cd /opt/propyte && docker compose -f docker-compose.prod.yml exec -T scraper-core python -m orchestrator.scheduler etl >> /var/log/propyte/backup.log 2>&1

# Log rotation
0 0 * * * find /var/log/propyte -name "*.log" -mtime +30 -delete
